# ── Chat ────────────────────────────────────────────────────────────────
# Sem GROQ_API_KEY o chat roda em MODO MOCK: a UX inteira funciona com
# respostas simuladas. Dá para desenvolver e testar sem criar conta.
#
# Chave gratuita (não pede cartão): https://console.groq.com/keys
GROQ_API_KEY=

# ── Retrieval (opção B) ─────────────────────────────────────────────────
# Embeddings do Gemini: os chunks são embedados no build, a pergunta em
# runtime. Corta o custo por pergunta de ~3.900 para ~1.300 tokens, que é
# o que permite 4 perguntas/min em vez de 1 no free tier do Groq.
#
# SEM esta chave o chat cai para a opção A (contexto inteiro no prompt):
# continua respondendo certo, só consome mais cota.
#
# Chave gratuita (não pede cartão): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Orçamento de cota ───────────────────────────────────────────────────
# Rate limit e contador global de tokens, compartilhado entre instâncias.
# Opcional em dev — sem isso cai num limitador em memória.
# Free tier (não pede cartão): https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
